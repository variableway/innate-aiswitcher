.task/

# docmd documentation site
/node_modules/
/site/

# Web frontend (Vite build synced into internal/webui/dist for embedding)
web/node_modules/
web/dist/

# GUI test evidence screenshots (session artifacts)
gui-test-screenshots/

# Embedded web build output is produced locally via task web:build and never
# committed; a committed .placeholder keeps go:embed compiling on fresh clones
internal/webui/dist/*
!internal/webui/dist/.placeholder
